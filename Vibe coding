<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Мои Финансы">
<title>Мои Финансы</title>
<style>
:root{--bg:#0D0D0F;--card:rgba(255,255,255,0.04);--border:rgba(255,255,255,0.07);--text:#F0F0F0;--text2:#CCC;--text3:#888;--text4:#555;--accent:#4ECDC4;--accent2:#45B7D1;--danger:#FF6B6B;--green:#00B894;--yellow:#FFEAA7;--sb:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,'SF Pro Display','Helvetica Neue',sans-serif;background:var(--bg);color:var(--text);max-width:480px;margin:0 auto;min-height:100vh;-webkit-font-smoothing:antialiased;overscroll-behavior:none}
input,button,select,textarea{font-family:inherit}input:focus,select:focus,textarea:focus{outline:none}button{cursor:pointer;border:none;background:none}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastIn{from{opacity:0;transform:translateX(-50%) translateY(16px) scale(.92)}to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-10px)}40%{transform:translateX(10px)}60%{transform:translateX(-6px)}80%{transform:translateX(6px)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── PIN ── */
#pin-screen{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}
.pin-logo{font-size:40px;margin-bottom:12px}
.pin-title{font-size:18px;font-weight:700;margin-bottom:6px;text-align:center}
.pin-sub{font-size:13px;color:var(--text3);margin-bottom:28px;text-align:center}
.pin-dots{display:flex;gap:16px;margin-bottom:32px}
.pin-dot{width:16px;height:16px;border-radius:50%;border:2px solid var(--text4);transition:all .15s}
.pin-dot.on{background:var(--accent);border-color:var(--accent);transform:scale(1.1)}
.pin-dot.err{background:var(--danger);border-color:var(--danger);animation:shake .4s}
.pin-pad{display:grid;grid-template-columns:repeat(3,76px);gap:12px}
.pin-key{width:76px;height:76px;border-radius:50%;background:rgba(255,255,255,0.05);border:1px solid var(--border);color:var(--text);font-size:26px;font-weight:600;display:flex;align-items:center;justify-content:center;transition:all .1s}
.pin-key:active{background:rgba(78,205,196,0.18);transform:scale(.92)}
.pin-key.del{font-size:20px}
.pin-skip{margin-top:20px;color:var(--text4);font-size:13px;padding:8px 20px;border-radius:20px}

/* ── HEADER ── */
.hdr{padding:16px 18px 12px;background:linear-gradient(180deg,#161619 0%,var(--bg) 100%)}
.hdr-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.month-nav{display:flex;align-items:center;gap:6px}
.mnav-btn{color:var(--text3);font-size:20px;padding:3px 10px;border-radius:8px;line-height:1}
.mnav-btn:active{background:var(--card)}
.month-lbl{font-size:12px;color:var(--text3);font-weight:700;letter-spacing:.8px;text-transform:uppercase;min-width:130px;text-align:center}
.hdr-nums{display:flex;gap:8px;margin-bottom:10px}
.hdr-num{flex:1;padding:8px 10px;border-radius:10px;text-align:center}
.hdr-num .hn-lbl{font-size:10px;font-weight:600;margin-bottom:3px}
.hdr-num .hn-val{font-size:15px;font-weight:800;font-variant-numeric:tabular-nums}
.prog-track{height:6px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden}
.prog-fill{height:100%;border-radius:3px;transition:width .7s cubic-bezier(.23,1,.32,1),background .3s}

/* ── CONTENT ── */
.page{padding:14px 18px calc(76px + var(--sb));animation:fadeIn .25s ease}

/* ── INPUTS ── */
.amount-wrap{display:flex;align-items:center;justify-content:center;background:var(--card);border-radius:16px;padding:12px 16px;border:1px solid var(--border);margin-bottom:12px}
.amount-inp{background:transparent;border:none;color:var(--text);font-size:34px;font-weight:800;text-align:center;width:100%;caret-color:var(--accent);font-variant-numeric:tabular-nums}
.amount-sym{font-size:22px;font-weight:700;color:var(--text4);margin-left:6px;flex-shrink:0}
.field{width:100%;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:11px 14px;color:var(--text);font-size:14px;margin-bottom:10px}
.field::placeholder{color:var(--text4)}

/* ── TOGGLES ── */
.seg{display:flex;gap:6px;margin-bottom:12px}
.seg-btn{flex:1;padding:9px 6px;border-radius:11px;font-size:13px;font-weight:700;text-align:center;border:2px solid var(--border);color:var(--text3);transition:all .15s}
.seg-btn:active{transform:scale(.97)}
.seg-btn.exp-on{background:rgba(255,107,107,0.12);border-color:var(--danger);color:var(--danger)}
.seg-btn.inc-on{background:rgba(0,184,148,0.12);border-color:var(--green);color:var(--green)}
.seg-btn.sav-on{background:rgba(78,205,196,0.12);border-color:var(--accent);color:var(--accent)}

.cur-row{display:flex;gap:6px;margin-bottom:12px}
.cur-btn{flex:1;padding:7px 4px;border-radius:10px;font-size:12px;font-weight:700;text-align:center;border:2px solid var(--border);color:var(--text3);transition:all .15s}
.cur-btn.on{border-color:var(--accent);background:rgba(78,205,196,0.1);color:var(--accent)}

/* ── CATEGORIES ── */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:12px}
.cat-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px 3px;border-radius:13px;border:2px solid rgba(255,255,255,0.08);background:var(--card);transition:all .15s;min-height:64px}
.cat-btn:active{transform:scale(.93)}
.cat-btn.on{transform:scale(1.05)}
.cat-btn .ci{font-size:22px}.cat-btn .cn{font-size:9px;font-weight:600;margin-top:3px;color:var(--text2);text-align:center;line-height:1.2}
.cat-btn.dashed{border-style:dashed;border-color:rgba(255,255,255,0.14)}

/* ── NEW CAT PANEL ── */
.panel{background:var(--card);border:1px solid rgba(78,205,196,0.2);border-radius:14px;padding:14px;margin-bottom:12px;animation:fadeIn .25s ease}
.panel-title{font-size:13px;font-weight:700;color:var(--accent);margin-bottom:10px}
.panel-sub{font-size:10px;font-weight:700;color:var(--text4);margin:8px 0 5px;text-transform:uppercase;letter-spacing:.5px}
.icon-grid{display:flex;flex-wrap:wrap;gap:5px}
.icon-opt{width:36px;height:36px;border-radius:9px;font-size:17px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.04);border:2px solid transparent;transition:all .12s}
.icon-opt.on{background:rgba(78,205,196,0.2);border-color:var(--accent)}
.clr-grid{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:4px}
.clr-opt{width:26px;height:26px;border-radius:50%;border:3px solid transparent;transition:all .12s}
.clr-opt.on{border-color:#FFF;transform:scale(1.25)}
.preview-row{display:flex;align-items:center;gap:10px;margin-top:12px}
.preview-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:20px}

/* ── BUTTONS ── */
.btn-primary{width:100%;padding:13px;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#0D0D0F;font-size:15px;font-weight:800;transition:opacity .2s}
.btn-primary:disabled{opacity:.35}
.btn-income{background:linear-gradient(135deg,var(--green),#00CEC9)}
.btn-sm{padding:7px 14px;border-radius:10px;background:var(--accent);color:#0D0D0F;font-weight:700;font-size:13px}
.btn-danger{width:100%;padding:13px;border-radius:14px;border:1px solid rgba(255,107,107,0.2);background:rgba(255,107,107,0.06);color:var(--danger);font-size:14px;font-weight:700;margin-top:10px}
.btn-outline{width:100%;padding:11px;border-radius:14px;border:1px solid var(--border);color:var(--text2);font-size:14px;font-weight:600;margin-top:8px}

/* ── ROWS ── */
.sec{font-size:11px;font-weight:700;color:var(--text4);margin-bottom:9px;letter-spacing:.6px;text-transform:uppercase}
.row{display:flex;align-items:center;padding:11px 12px;margin-bottom:5px;background:var(--card);border-radius:11px;border:1px solid rgba(255,255,255,0.04);animation:fadeIn .25s ease}
.row .ri{font-size:20px;flex-shrink:0}
.row .rinfo{flex:1;margin-left:9px}
.row .rname{font-size:13px;font-weight:600;color:#DDD}
.row .rdate{font-size:10px;color:var(--text4);margin-top:2px}
.row .rsum{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.del-btn{background:rgba(255,107,107,0.1);color:var(--danger);border-radius:8px;width:28px;height:28px;font-size:12px;display:flex;align-items:center;justify-content:center;margin-left:6px;flex-shrink:0}

/* ── CHARTS ── */
.chart-box{background:rgba(255,255,255,0.02);border-radius:14px;padding:14px 10px;border:1px solid rgba(255,255,255,0.04);margin-bottom:14px}
.chart-box canvas{width:100%;display:block}
.cat-item{display:flex;align-items:center;gap:7px;padding:7px 10px;background:rgba(255,255,255,0.02);border-radius:9px;margin-bottom:4px}
.cdot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.cname{flex:1;font-size:12px;font-weight:600}
.cval{font-size:12px;font-weight:700;font-variant-numeric:tabular-nums}
.cpct{font-size:10px;color:var(--text3);width:30px;text-align:right}

/* ── STATS ── */
.stats3{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:14px}
.stat{text-align:center;padding:12px 6px;background:var(--card);border-radius:12px;border:1px solid rgba(255,255,255,0.04)}
.stat .sv{font-size:15px;font-weight:800;color:var(--accent)}
.stat .sl{font-size:9px;color:var(--text4);margin-top:3px;font-weight:600}

/* ── TIPS ── */
.tip{background:linear-gradient(135deg,rgba(78,205,196,0.07),rgba(69,183,209,0.04));border:1px solid rgba(78,205,196,0.14);border-radius:13px;padding:13px;margin-bottom:9px}
.tip-lbl{font-size:10px;color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.tip-txt{font-size:13px;line-height:1.55;color:var(--text2)}

/* ── COMPARE ── */
.cmp-row{padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.04)}
.cmp-bars{display:flex;gap:4px;align-items:flex-end;height:28px;margin-top:6px}
.cmp-bar{border-radius:3px 3px 0 0;min-width:4px;transition:height .5s}

/* ── SAVINGS ── */
.sav-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px}
.sav-card h4{font-size:14px;font-weight:700;margin-bottom:8px}
.sav-prog{height:8px;background:rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;margin:8px 0}
.sav-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .6s}
.sav-info{display:flex;justify-content:space-between;font-size:11px;color:var(--text3)}

/* ── BANKS ── */
.bank{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:12px;margin-bottom:8px}
.bank-name{font-size:13px;font-weight:700;color:var(--accent)}
.bank-rate{font-size:22px;font-weight:800;color:var(--green);margin:3px 0}
.bank-info{font-size:11px;color:var(--text3);line-height:1.6}

/* ── SETTINGS ── */
.set-card{padding:14px;background:var(--card);border-radius:14px;border:1px solid rgba(255,255,255,0.04);margin-bottom:10px}
.set-lbl{font-size:11px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.set-val{margin-top:5px;font-size:17px;font-weight:700;color:var(--text)}
.set-val .ed{font-size:12px;opacity:.4}
.bud-edit{display:flex;gap:8px;margin-top:8px}
.bud-edit .field{margin:0;flex:1}
.cc-row{display:flex;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.04)}

/* ── NAV ── */
.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;display:flex;justify-content:space-around;background:rgba(13,13,15,0.96);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);border-top:1px solid rgba(255,255,255,0.06);padding:6px 0 calc(10px + var(--sb));z-index:100}
.nav-btn{display:flex;flex-direction:column;align-items:center;font-weight:600;transition:color .2s;padding:4px 6px;color:var(--text4);font-size:9px;min-width:56px}
.nav-btn:active{transform:scale(.94)}
.nav-btn .ni{font-size:18px;margin-bottom:1px;transition:font-size .15s}
.nav-btn.on{color:var(--accent)}
.nav-btn.on .ni{font-size:20px}

/* ── TOAST ── */
.toast{position:fixed;bottom:calc(74px + var(--sb));left:50%;transform:translateX(-50%);background:#1A1A1E;color:var(--accent);padding:9px 22px;border-radius:30px;font-size:13px;font-weight:700;z-index:300;border:1px solid rgba(78,205,196,0.3);animation:toastIn .3s ease;pointer-events:none;white-space:nowrap}

.empty{text-align:center;color:var(--text4);padding:32px 0;font-size:13px}
.divider{height:1px;background:var(--border);margin:14px 0}
.about-txt{margin-top:20px;text-align:center;padding:12px;font-size:11px;color:var(--text4);line-height:1.8}
</style>
</head>
<body>
<div id="pin-screen" style="display:none"></div>
<div id="app"></div>

<script>
'use strict';
/* ═══════════════════════════ DATA ═══════════════════════════ */
const MONTHS=["Январь","Февраль","Март","Апрель","Май","Июнь","Июль","Август","Сентябрь","Октябрь","Ноябрь","Декабрь"];
const SHORT=["янв","фев","мар","апр","май","июн","июл","авг","сен","окт","ноя","дек"];

const DEF_CATS=[
  {id:"food",name:"Еда",icon:"🍔",color:"#FF6B6B"},
  {id:"transport",name:"Транспорт",icon:"🚕",color:"#4ECDC4"},
  {id:"housing",name:"Жильё",icon:"🏠",color:"#45B7D1"},
  {id:"health",name:"Здоровье",icon:"💊",color:"#96CEB4"},
  {id:"clothes",name:"Одежда",icon:"👕",color:"#FFEAA7"},
  {id:"fun",name:"Развлечения",icon:"🎮",color:"#DDA0DD"},
  {id:"education",name:"Обучение",icon:"📚",color:"#74B9FF"},
  {id:"other",name:"Прочее",icon:"📦",color:"#A8A8A8"},
];
const INC_CATS=[
  {id:"salary",name:"Зарплата",icon:"💼",color:"#00B894"},
  {id:"freelance",name:"Фриланс",icon:"💻",color:"#00CEC9"},
  {id:"transfer",name:"Перевод",icon:"🔄",color:"#6C5CE7"},
  {id:"gift",name:"Подарок",icon:"🎁",color:"#FD79A8"},
  {id:"business",name:"Бизнес",icon:"🏢",color:"#FDCB6E"},
  {id:"other_inc",name:"Прочее",icon:"💰",color:"#A29BFE"},
];
const ICONS=["🏪","🛒","☕","🍕","🎬","✈️","🏋️","💇","🐾","🎁","📱","💻","🔧","🚌","⛽","🏥","👶","🎓","💰","🏦","🧾","🍽️","🛍️","🚗","🏢","💼","🎵","📷","🌿","🧹","⚽","🎸","🍷","🐕","🌸"];
const CLRS=["#FF6B6B","#4ECDC4","#45B7D1","#96CEB4","#FFEAA7","#DDA0DD","#74B9FF","#FF8A5C","#A29BFE","#FD79A8","#00B894","#E17055","#6C5CE7","#FDCB6E","#E84393","#00CEC9"];
const CURS=[{id:"KZT",sym:"₸",name:"Тенге"},{id:"USD",sym:"$",name:"Доллар"},{id:"RUB",sym:"₽",name:"Рубль"}];
const BANKS=[
  {name:"Kaspi Депозит",rate:"15.0%",min:"от 1 000 ₸",term:"Без срока",note:"Ежедневная капитализация. Пополнение и снятие без ограничений."},
  {name:"Halyk Bank",rate:"14.5%",min:"Без минимума",term:"от 3 мес",note:"Самый крупный банк РК. Частичное снятие без потери процентов."},
  {name:"Bereke Bank",rate:"15.2%",min:"от 50 000 ₸",term:"12 мес",note:"Максимальная ставка при срочном вкладе без досрочного снятия."},
  {name:"Jusan Bank",rate:"14.8%",min:"от 5 000 ₸",term:"от 6 мес",note:"Повышенная ставка при ежемесячном пополнении."},
  {name:"Freedom Finance",rate:"14.0%",min:"от 1 000 ₸",term:"от 1 мес",note:"Гибкие условия, можно снимать часть средств в любое время."},
];

/* ═══════════════════════════ STORAGE ═══════════════════════════ */
const LS={
  g:(k,d)=>{try{const v=localStorage.getItem(k);return v!=null?JSON.parse(v):d}catch{return d}},
  s:(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}}
};
let _ = {
  expenses:  LS.g('mf_exp',[]),
  cats:      LS.g('mf_cats',[]),
  budget:    LS.g('mf_bud',200000),
  savings:   LS.g('mf_sav',[]),
  pin:       LS.g('mf_pin',null),
  reminders: LS.g('mf_rem',false),
  // ui
  view:'add', type:'expense', cur:'KZT',
  selCat:null, amount:'', note:'',
  showCatPanel:false, newName:'', newIcon:'🏪', newClr:'#FF8A5C',
  vMonth:new Date().getMonth(), vYear:new Date().getFullYear(),
  editBudget:false, budInp:'',
  showSavPanel:false, savName:'', savGoal:'', savAmt:'',
  toast:null, toastT:null,
  pinLocked:false, pinSetup:false, pinStep:1, pinFirst:'', pinInp:'', pinErr:false,
};

const save=()=>{LS.s('mf_exp',_.expenses);LS.s('mf_cats',_.cats);LS.s('mf_bud',_.budget);LS.s('mf_sav',_.savings);LS.s('mf_pin',_.pin);LS.s('mf_rem',_.reminders)};

// Init PIN lock
if(_.pin){_.pinLocked=true}

/* ═══════════════════════════ HELPERS ═══════════════════════════ */
const allCats=()=>[...DEF_CATS,..._.cats];
const getCat=id=>[...allCats(),...INC_CATS].find(c=>c.id===id)||DEF_CATS[7];
const getCur=id=>CURS.find(c=>c.id===id)||CURS[0];

function fmt(n,cur){
  const s=getCur(cur||'KZT').sym;
  if(n>=1000000)return(n/1000000).toFixed(1).replace(/\.0$/,'')+'M '+s;
  if(n>=10000)return Math.round(n/1000)+'K '+s;
  return Math.round(n).toLocaleString('ru-RU')+' '+s;
}
function fmtDate(iso){
  const d=new Date(iso);
  return d.toLocaleDateString('ru-RU',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});
}
function mExps(m,y,type){
  return _.expenses.filter(e=>{
    const d=new Date(e.date);
    return d.getMonth()===m&&d.getFullYear()===y&&(!type||e.type===type);
  });
}
function mTotal(m,y,type){return mExps(m,y,type).reduce((s,e)=>s+e.amount,0)}

function toast(msg){
  clearTimeout(_.toastT);
  _.toast=msg; render();
  _.toastT=setTimeout(()=>{_.toast=null;render()},2200);
}

/* ═══════════════════════════ DOM ═══════════════════════════ */
function h(tag,attrs,...ch){
  const el=document.createElement(tag);
  if(attrs) Object.entries(attrs).forEach(([k,v])=>{
    if(k==='class')el.className=v;
    else if(k.startsWith('on'))el.addEventListener(k.slice(2).toLowerCase(),v);
    else if(k==='style'&&typeof v==='object')Object.assign(el.style,v);
    else el.setAttribute(k,v);
  });
  ch.flat(9).forEach(c=>{if(c==null||c===false)return;el.appendChild(typeof c==='string'?document.createTextNode(c):c)});
  return el;
}

/* ═══════════════════════════ CHARTS ═══════════════════════════ */
function drawPie(cv,data){
  const ctx=cv.getContext('2d'),dpr=devicePixelRatio||1;
  const w=cv.parentElement.clientWidth-20,ht=180;
  cv.width=w*dpr;cv.height=ht*dpr;cv.style.width=w+'px';cv.style.height=ht+'px';
  ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,ht);
  const tot=data.reduce((s,d)=>s+d.value,0);if(!tot)return;
  let a=-Math.PI/2;
  data.forEach(d=>{
    const sl=(d.value/tot)*Math.PI*2;
    ctx.beginPath();ctx.arc(w/2,ht/2,78,a,a+sl);ctx.arc(w/2,ht/2,46,a+sl,a,true);
    ctx.closePath();ctx.fillStyle=d.color;ctx.fill();a+=sl+.025;
  });
  ctx.fillStyle=getComputedStyle(document.body).getPropertyValue('--bg')||'#0D0D0F';
}

function drawBars(cv,data,color){
  const ctx=cv.getContext('2d'),dpr=devicePixelRatio||1;
  const w=cv.parentElement.clientWidth-20,ht=130;
  cv.width=w*dpr;cv.height=ht*dpr;cv.style.width=w+'px';cv.style.height=ht+'px';
  ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,ht);
  const max=Math.max(...data.map(d=>d.v),1);
  const bw=Math.min(22,(w-24)/data.length-6);
  const gap=(w-bw*data.length)/(data.length+1);
  const ch=ht-22;
  data.forEach((d,i)=>{
    const x=gap+i*(bw+gap),bh=(d.v/max)*(ch-6),y=ch-bh;
    if(bh>0){
      ctx.beginPath();
      const r=Math.min(5,bw/2);
      ctx.moveTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.lineTo(x+bw-r,y);
      ctx.quadraticCurveTo(x+bw,y,x+bw,y+r);ctx.lineTo(x+bw,ch);ctx.lineTo(x,ch);
      ctx.closePath();ctx.fillStyle=color||'#4ECDC4';ctx.fill();
    }
    ctx.fillStyle='#666';ctx.font=`9px -apple-system,sans-serif`;ctx.textAlign='center';
    ctx.fillText(d.l,x+bw/2,ht-4);
  });
}

