function exportCSV(){
  const me=mExps(_.vMonth,_.vYear);
  if(!me.length){toast('Нет данных для экспорта');return;}
  const rows=[['Дата','Тип','Категория','Сумма','Валюта','Заметка']];
  me.forEach(e=>{
    const cat=getCat(e.category);
    const d=new Date(e.date);
    rows.push([d.toLocaleDateString('ru-RU'),e.type==='income'?'Доход':'Расход',cat.name,e.amount,e.currency||'KZT',e.note||'']);
  });
  const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.download=`расходы_${MONTHS[_.vMonth]}_${_.vYear}.csv`;a.click();
  URL.revokeObjectURL(url);toast('✓ CSV скачан');
}

