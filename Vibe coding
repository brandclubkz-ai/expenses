function getAITips(catData,spent,prevSpent,income){
  const tips=[];
  if(catData.length&&catData[0].value>spent*.4)
    tips.push({label:'🔴 Главный расход',text:`${catData[0].icon} "${catData[0].name}" — это ${Math.round(catData[0].value/spent*100)}% всех расходов. Попробуйте установить лимит на эту категорию.`});
  if(prevSpent>0&&spent>prevSpent*1.15)
    tips.push({label:'📈 Рост расходов',text:`Расходы выросли на ${Math.round((spent/prevSpent-1)*100)}% по сравнению с прошлым месяцем. Проверьте крупные разовые траты.`});
  if(prevSpent>0&&spent<prevSpent*0.85)
    tips.push({label:'✅ Экономия',text:`Отлично! Расходы снизились на ${Math.round((1-spent/prevSpent)*100)}% по сравнению с прошлым месяцем. Хороший результат!`});
  if(income>0&&spent>income*0.9)
    tips.push({label:'⚠️ Баланс',text:`Расходы составляют ${Math.round(spent/income*100)}% от дохода. Финансовые эксперты рекомендуют тратить не более 80% и откладывать 20%.`});
  if(income>0&&spent<income*0.6)
    tips.push({label:'💰 Свободные деньги',text:`У вас остаётся ${Math.round((1-spent/income)*100)}% от дохода. Рассмотрите депозит в Kaspi или Halyk — ставки до 15% годовых.`});
  const daily=Math.round(spent/Math.max(new Date().getDate(),1));
  const dLeft=new Date(_.vYear,_.vMonth+1,0).getDate()-new Date().getDate();
  if(dLeft>0&&_.budget>0){
    const proj=daily*(new Date().getDate()+dLeft);
    tips.push({label:'📊 Прогноз',text:`При темпе ${fmt(daily)}/день к концу месяца потратите ~${fmt(proj)}. ${proj>_.budget?`Бюджет (${fmt(_.budget)}) будет превышен на ${fmt(proj-_.budget)}!`:'Укладываетесь в бюджет ✓'}`});
  }
  if(!tips.length)
    tips.push({label:'💡 Совет',text:'Записывайте каждую трату в день покупки — так легче контролировать бюджет. Даже мелкие расходы в сумме могут быть значительными.'});
  return tips;
}

