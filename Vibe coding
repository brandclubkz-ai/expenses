    const n2=h('input',{type:'text',class:'field',inputmode:'numeric',placeholder:'Цель в тенге (напр. 500000)',value:_.savGoal});n2.addEventListener('input',e=>{_.savGoal=e.target.value.replace(/\D/g,'')});p.appendChild(n2);
    const n3=h('input',{type:'text',class:'field',inputmode:'numeric',placeholder:'Уже накоплено (если есть)',value:_.savAmt});n3.addEventListener('input',e=>{_.savAmt=e.target.value.replace(/\D/g,'')});p.appendChild(n3);
    p.appendChild(h('button',{class:'btn-sm',style:{width:'100%',padding:'11px',fontSize:'14px'},onClick:()=>{
      if(!_.savName.trim()||!_.savGoal)return;
      _.savings.push({id:'s'+Date.now().toString(36),name:_.savName.trim(),goal:Number(_.savGoal),current:Number(_.savAmt||0),created:new Date().toISOString()});
      _.savName='';_.savGoal='';_.savAmt='';_.showSavPanel=false;save();toast('✓ Цель добавлена!');
    }},'Создать цель'));
    pg.appendChild(p);
  }

  if(!_.savings.length)pg.appendChild(h('div',{class:'empty'},'Добавьте первую цель'));

  _.savings.forEach(sv=>{
    const pct=sv.goal?Math.min(sv.current/sv.goal*100,100):0;
    const left=sv.goal-sv.current;
    const card=h('div',{class:'sav-card'});
    card.appendChild(h('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'flex-start',marginBottom:'4px'}},
      h('div',null,
        h('h4',null,'🎯 '+sv.name),
        h('div',{style:{fontSize:'11px',color:'#555',marginTop:'2px'}},left>0?`Осталось: ${fmt(left)}`:'✅ Цель достигнута!'),
      ),
      h('button',{class:'del-btn',onClick:()=>{_.savings=_.savings.filter(x=>x.id!==sv.id);save();toast('Удалено')}},'✕'),
    ));
    card.appendChild(h('div',{class:'sav-prog'},h('div',{class:'sav-fill',style:{width:pct+'%'}})));
    card.appendChild(h('div',{class:'sav-info'},h('span',null,fmt(sv.current)+' из '+fmt(sv.goal)),h('span',null,Math.round(pct)+'%')));
    const addI=h('input',{type:'text',class:'field',inputmode:'numeric',placeholder:'Добавить сумму ₸',style:{marginTop:'10px',marginBottom:'6px'}});
    card.appendChild(addI);
    card.appendChild(h('button',{class:'btn-sm',style:{fontSize:'12px',padding:'7px 14px'},onClick:()=>{
      const v=Number(addI.value.replace(/\D/g,''));if(v>0){sv.current=Math.min(sv.current+v,sv.goal);save();toast('+'+fmt(v));render();}
    }},'Пополнить'));
    pg.appendChild(card);
  });

  // Banks
  pg.appendChild(h('div',{class:'sec',style:{marginTop:'20px'}},'🏦 Депозиты казахстанских банков'));
  BANKS.forEach(b=>{
    pg.appendChild(h('div',{class:'bank'},
      h('div',{class:'bank-name'},b.name),
      h('div',{class:'bank-rate'},'↑ '+b.rate+' годовых'),
      h('div',{class:'bank-info'},'Мин. сумма: '+b.min+' · '+b.term),
      h('div',{class:'bank-info',style:{marginTop:'3px',color:'#666'}},b.note),
    ));
  });
  pg.appendChild(h('div',{style:{fontSize:'10px',color:'#444',marginTop:'6px',textAlign:'center'}},'* Ставки ориентировочные, уточняйте актуальные в приложениях банков'));
  return pg;
}

/* ═══════════════════════════ SETTINGS PAGE ═══════════════════════════ */
function renderSettings(){
  const pg=h('div',{class:'page'});
  pg.appendChild(h('div',{class:'sec'},'Настройки'));

  // Budget
  const bc=h('div',{class:'set-card'});
  bc.appendChild(h('div',{class:'set-lbl'},'Бюджет на месяц'));
  if(_.editBudget){
    const bi=h('input',{type:'text',inputmode:'numeric',class:'field',value:_.budInp,style:{margin:'0',flex:'1'}});
    bi.addEventListener('input',e=>{_.budInp=e.target.value.replace(/\D/g,'')});
    bc.appendChild(h('div',{class:'bud-edit'},bi,h('button',{class:'btn-sm',onClick:()=>{const v=parseInt(_.budInp);if(v>0)_.budget=v;_.editBudget=false;save();render()}},'✓')));
  }else{
    bc.appendChild(h('button',{class:'set-val',style:{display:'block',textAlign:'left',cursor:'pointer'},onClick:()=>{_.budInp=String(_.budget);_.editBudget=true;render()}},
      fmt(_.budget),' ',h('span',{class:'ed'},'✎')));
  }
  pg.appendChild(bc);

  // PIN
  const pc=h('div',{class:'set-card'});
  pc.appendChild(h('div',{class:'set-lbl'},'ПИН-код'));
  if(_.pin){
    pc.appendChild(h('div',{style:{display:'flex',gap:'8px',marginTop:'8px',alignItems:'center'}},
      h('div',{style:{flex:'1',fontSize:'14px',color:'#00B894',fontWeight:'600'}},'✓ Установлен'),
      h('button',{class:'btn-sm',style:{background:'var(--danger)',fontSize:'12px',padding:'6px 12px'},onClick:()=>{_.pin=null;save();toast('ПИН удалён')}},'Удалить'),
    ));
  }else{
    pc.appendChild(h('button',{class:'btn-sm',style:{marginTop:'8px',fontSize:'13px'},onClick:()=>{_.pinSetup=true;_.pinStep=1;_.pinInp='';_.pinFirst='';_.pinLocked=true;const ps=document.getElementById('pin-screen');renderPin();ps.style.display='flex';}},'Установить ПИН'));
  }
  pg.appendChild(pc);

  // Reminders
  const rc=h('div',{class:'set-card'});
  rc.appendChild(h('div',{class:'set-lbl'},'Напоминания'));
  rc.appendChild(h('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginTop:'8px'}},
    h('div',{style:{fontSize:'13px',color:'var(--text2)'}},'Напоминать записывать расходы'),
    h('button',{style:{width:'44px',height:'26px',borderRadius:'13px',background:_.reminders?'var(--accent)':'rgba(255,255,255,0.1)',transition:'background .2s',position:'relative'},onClick:()=>{
      _.reminders=!_.reminders;save();
      if(_.reminders&&'Notification' in window){
        Notification.requestPermission().then(p=>{if(p==='granted')scheduleReminder();});
      }
      render();
    }},
      h('div',{style:{width:'20px',height:'20px',borderRadius:'50%',background:'white',position:'absolute',top:'3px',transition:'left .2s',left:_.reminders?'21px':'3px'}}),
    ),
  ));
  rc.appendChild(h('div',{style:{fontSize:'11px',color:'#555',marginTop:'6px'}},'Ежедневно в 20:00 — напомнит записать траты'));
  pg.appendChild(rc);

  // Custom cats
  const cc=h('div',{class:'set-card'});
  cc.appendChild(h('div',{class:'set-lbl'},'Мои категории'));
  if(!_.cats.length)cc.appendChild(h('div',{style:{fontSize:'12px',color:'#555',marginTop:'6px'}},'Нет своих категорий. Добавьте через «＋ Своя».'));
  _.cats.forEach(c=>{
    cc.appendChild(h('div',{class:'cc-row'},
      h('span',{style:{fontSize:'18px'}},c.icon),
      h('span',{style:{flex:'1',marginLeft:'8px',fontSize:'13px',fontWeight:'600'}},c.name),
      h('div',{class:'cdot',style:{background:c.color,width:'12px',height:'12px'}}),
      h('button',{class:'del-btn',style:{marginLeft:'8px'},onClick:()=>{_.cats=_.cats.filter(x=>x.id!==c.id);save();toast('Удалено')}},'✕'),
    ));
  });
  pg.appendChild(cc);

  // Export
  pg.appendChild(h('button',{class:'btn-outline',onClick:()=>{_.vMonth=new Date().getMonth();_.vYear=new Date().getFullYear();exportCSV()}},'📥 Экспорт текущего месяца в CSV'));

  // Danger
  pg.appendChild(h('button',{class:'btn-danger',onClick:()=>{if(confirm('Удалить ВСЕ данные? Это нельзя отменить.')){_.expenses=[];_.savings=[];save();toast('Все данные удалены');}}},'🗑 Удалить все данные'));

  pg.appendChild(h('div',{class:'about-txt'},'Мои Финансы v2.0\nДанные хранятся на вашем устройстве\nРаботает полностью офлайн 📱'));
  return pg;
}

function scheduleReminder(){
  if(!('serviceWorker' in navigator))return;
  const now=new Date(),rem=new Date(now);
  rem.setHours(20,0,0,0);if(rem<=now)rem.setDate(rem.getDate()+1);
  const ms=rem-now;
  setTimeout(()=>{
    if(_.reminders)new Notification('Мои Финансы 💳',{body:'Не забудьте записать расходы за сегодня!',icon:'💳'});
    setInterval(()=>{if(_.reminders)new Notification('Мои Финансы 💳',{body:'Не забудьте записать расходы за сегодня!',icon:'💳'})},86400000);
  },ms);
}

/* ═══════════════════════════ NAV ═══════════════════════════ */
function renderNav(){
  const tabs=[
    {id:'add',ni:'＋',l:'Ввод'},
    {id:'list',ni:'☰',l:'История'},
    {id:'analytics',ni:'◔',l:'Аналитика'},
    {id:'savings',ni:'🎯',l:'Цели'},
    {id:'settings',ni:'⚙',l:'Ещё'},
  ];
  return h('div',{class:'nav'},...tabs.map(t=>
    h('button',{class:`nav-btn${_.view===t.id?' on':''}`,onClick:()=>{_.view=t.id;render()}},
      h('span',{class:'ni'},t.ni),t.l)
  ));
}

/* ═══════════════════════════ RENDER ═══════════════════════════ */
function render(){
  const app=document.getElementById('app');
  app.innerHTML='';
  app.appendChild(renderHeader());
  switch(_.view){
    case'add':      app.appendChild(renderAdd());       break;
    case'list':     app.appendChild(renderList());      break;
    case'analytics':app.appendChild(renderAnalytics()); break;
    case'savings':  app.appendChild(renderSavings());   break;
    case'settings': app.appendChild(renderSettings());  break;
  }
  app.appendChild(renderNav());
  if(_.toast)app.appendChild(h('div',{class:'toast'},_.toast));
}

// Init
if(_.pinLocked){renderPin();document.getElementById('pin-screen').style.display='flex';}
else{render();}
</script>
</body>
</html>
